# go2rtc 链路复活所需环境变量（占位模板，非真值、不入库）
# 原属仓根 .env.example:17，2026-11-12 随链路归档移入。
# 真值只从 .env 注入，不落盘、不打印；凭据零打印。
#
# 注意：以下键在当前现用链路里一个都没有被消费，只有复活本链路时才需要。

# ===== go2rtc Basic Auth（legacy.py 的 go2rtc_basic_auth_header / warmup / RTSP 刷新）=====
GO2RTC_BASE_URL=http://192.168.2.200:1984
GO2RTC_USER=<GO2RTC_USER>
GO2RTC_PASS=<GO2RTC_PASS>

# ===== 一次性摄像头 M3U 注入脚本 scripts/patch_cameras_m3u.py =====
GO2RTC_AUTH=<GO2RTC_USER>:<GO2RTC_PASS>

# ===== RTSP 刷新端点鉴权 / 限流（复活 tvpilot_server.py 的刷新链时）=====
TVPILOT_ADMIN_TOKEN=<REPLACE_WITH_ADMIN_TOKEN>
TVPILOT_DEVICE_TOKEN=<REPLACE_WITH_DEVICE_TOKEN>
TVPILOT_REFRESH_OPEN=0
TVPILOT_REFRESH_MIN_INTERVAL=120
DOCKER_SOCK=/var/run/docker.sock

# ===== 一次性摄像头还原脚本 scripts/restore_cameras.py =====
# XIAOMI_UID / XIAOMI_TOKEN / XIAOMI_AUTH 三个键未随本链路移走，
# 键名仍见仓根 .env.example（当前部署的必填项）。
