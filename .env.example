# TVPilot 本地环境变量模板
# 用法：复制为 .env 后填值；.env 已被 .gitignore 排除，永不入库
# 2026-11-11：docker-compose.yml 原有明文 DOUBAO_API_KEY 已按「已泄露」处理，
# 必须由 DB 侧轮换后把新值填在这里，旧值一律作废、不复述、不回填。
#
# 以下 7 个键全部必填（11-11 新增 7 项，AF-PM 11-11 裁定）；原第 8 项 GO2RTC_AUTH
# 已随 go2rtc 链路归档移入 archive/go2rtc/.env.example，复活时再填（见其 README）。
# 缺任一项即 fail-fast 报错退出，绝不以空值静默生成错误相机表或未签名请求。
# 键名与消费方对照见 secrets/README.md；全部为 <...> 角占位模板，非真值、不入库。
DOUBAO_API_KEY=<REPLACE_WITH_ROTATED_KEY>

# ===== 小米电视 6095 协议常量（值未复核，按 env 注入；部署前填真值）=====
MITV_API_KEY=<REPLACE_WITH_MITV_API_KEY>
MITV_HMAC_KEY=<REPLACE_WITH_MITV_HMAC_KEY>
MITV_PLAY_SALT=<REPLACE_WITH_MITV_PLAY_SALT>

# ===== 一次性运维脚本（凭据不落盘、不入库）=====
# GO2RTC_AUTH 已移入 archive/go2rtc/.env.example；本模板不再列该键。
XIAOMI_UID=<REPLACE_WITH_XIAOMI_UID>
XIAOMI_TOKEN=<REPLACE_WITH_XIAOMI_TOKEN>
XIAOMI_AUTH=<XIAOMI_UID>:<XIAOMI_REGION>